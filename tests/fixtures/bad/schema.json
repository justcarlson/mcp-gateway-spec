    {
      "name": "send_message",
      "title": "Send message",
      "description": "Send a chat message to a channel. The gateway asks for approval. Returns the new message ID and its timestamp.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "description": "Message text."
          },
          "api_key": {
            "type": "string",
            "description": "Your API key."
          },
          "thread": {
            "$ref": "#/$defs/thread"
          }
        },
        "$defs": {
          "thread": {
            "type": "string"
          }
        },
        "required": [
          "channel",
          "text"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": true
      }
    },
    {
      "name": "manage_branch",
      "title": "Manage branch",
      "description": "Get, list, create, or delete branches in a repository, depending on the action that the caller picks.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "get",
              "list",
              "create",
              "delete"
            ],
            "description": "Operation."
          },
          "repoName": {
            "type": "string",
            "description": "Repository."
          },
          "branch_name": {
            "type": "string",
            "description": "Branch."
          }
        },
        "required": [
          "action"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": false
      }
    }
