{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/justcarlson/mcp-gateway-spec/blob/main/upstream.schema.json",
  "title": "mcp-gateway-spec upstream revisions",
  "description": "The MCP revisions this spec version targets and supports. Read by the checker, CI, and the README.",
  "type": "object",
  "required": ["mcp"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string"},
    "mcp": {
      "type": "object",
      "required": ["repo", "target", "supported", "revisions"],
      "additionalProperties": false,
      "properties": {
        "repo": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "target": {"$ref": "#/$defs/revision"},
        "supported": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/revision"}
        },
        "draft": {
          "type": "object",
          "required": ["ref", "url"],
          "additionalProperties": false,
          "properties": {"ref": {"type": "string"}, "url": {"type": "string", "format": "uri"}}
        },
        "revisions": {
          "type": "object",
          "propertyNames": {"$ref": "#/$defs/revision"},
          "additionalProperties": {"$ref": "#/$defs/entry"}
        }
      }
    }
  },
  "$defs": {
    "revision": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release": {
      "type": "object",
      "required": ["tag", "commit", "published_at", "release_url"],
      "properties": {
        "tag": {"type": "string"},
        "commit": {"$ref": "#/$defs/sha"},
        "published_at": {"type": "string", "format": "date-time"},
        "release_url": {"type": "string", "format": "uri"}
      }
    },
    "entry": {
      "allOf": [{"$ref": "#/$defs/release"}],
      "type": "object",
      "required": ["status", "changelog_url", "verified_on"],
      "unevaluatedProperties": false,
      "properties": {
        "status": {"enum": ["rc", "final"]},
        "changelog_url": {"type": "string", "format": "uri"},
        "schema_url": {"type": "string", "format": "uri"},
        "rc": {"$ref": "#/$defs/release", "unevaluatedProperties": false},
        "verified_on": {"type": "string", "format": "date"}
      }
    }
  }
}
